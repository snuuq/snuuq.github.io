---
import { giscusConfig } from "../config/site";

interface Props {
  term: string;
}

const { term } = Astro.props;
const ready =
  giscusConfig.repo &&
  giscusConfig.repoId &&
  giscusConfig.category &&
  giscusConfig.categoryId;
---

{ready ? (
  <div class="panel">
    <div id="giscus-thread"></div>
  </div>
) : (
  <div class="giscus-fallback panel">
    <div class="eyebrow">Comments</div>
    <p>
      giscus is scaffolded for this page, but repository metadata has not been configured yet. Fill in the repository,
      repo ID, category, and category ID in <code>src/config/site.ts</code> to activate page-specific discussions.
    </p>
    <div class="notice">
      Each session page is intended to map to its own GitHub Discussion. After setup, you can open or lock discussions
      individually from GitHub.
    </div>
  </div>
)}

{ready && (
  <script
    is:inline
    type="module"
    define:vars={{
      term,
      repo: giscusConfig.repo,
      repoId: giscusConfig.repoId,
      category: giscusConfig.category,
      categoryId: giscusConfig.categoryId,
      reactionsEnabled: giscusConfig.reactionsEnabled,
      inputPosition: giscusConfig.inputPosition,
      theme: giscusConfig.theme
    }}
  >
    const target = document.getElementById("giscus-thread");
    if (target) {
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      script.setAttribute("data-repo", repo);
      script.setAttribute("data-repo-id", repoId);
      script.setAttribute("data-category", category);
      script.setAttribute("data-category-id", categoryId);
      script.setAttribute("data-mapping", "specific");
      script.setAttribute("data-term", term);
      script.setAttribute("data-strict", "1");
      script.setAttribute("data-reactions-enabled", reactionsEnabled);
      script.setAttribute("data-input-position", inputPosition);
      script.setAttribute("data-theme", theme);
      script.setAttribute("data-lang", "en");
      target.appendChild(script);
    }
  </script>
)}
