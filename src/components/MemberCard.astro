---
import { avatarPlaceholder } from "../lib/placeholders";
import type { CollectionEntry } from "astro:content";

interface Props {
  member: CollectionEntry<"members">;
}

const { member } = Astro.props;
const roleTitleMap = {
  professor: "Professor",
  postdoc: "Postdoc Fellow",
  phd: "Ph.D. Student",
  ms: "M.S. Student",
  intern: "Intern"
};
const memberTitle = member.data.title ?? roleTitleMap[member.data.role];
---

<article class="member-card">
  <div class="avatar">
    <img src={avatarPlaceholder(member.data.nameEn)} alt={member.data.photoAlt ?? `Placeholder profile image for ${member.data.nameEn}`} />
  </div>
  <h3>{member.data.nameEn}</h3>
  <p class="muted">{member.data.nameKo} · {memberTitle}</p>
  <div class="member-copy">
    <slot />
  </div>
  <ul class="member-meta">
    <li>Joined {member.data.joined}</li>
    {member.data.emailMasked && <li>{member.data.emailMasked}</li>}
  </ul>
</article>
