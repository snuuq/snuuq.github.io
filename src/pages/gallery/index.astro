---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { formatLongDate } from "../../lib/dates";
import { bannerPlaceholder, galleryPlaceholder } from "../../lib/placeholders";

const albums = await Promise.all(
  (await getCollection("gallery")).map(async (album) => {
    const { Content } = await album.render();
    return { ...album, Content };
  })
);
---

<BaseLayout title="Gallery" currentPath="/gallery/">
  <PageHero title="Gallery" image={bannerPlaceholder("gallery")} titleClass="hero-gallery" />

  <section class="section">
    <div class="gallery-grid">
      {albums.map((album) => (
        <article class="gallery-card">
          <img src={album.data.image ?? galleryPlaceholder(album.data.title)} alt={album.data.imageAlt ?? album.data.title} />
          <h3>{album.data.title}</h3>
          {album.data.date && <div class="inline-meta"><span>{formatLongDate(album.data.date)}</span></div>}
          <div class="gallery-copy">
            <album.Content />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
