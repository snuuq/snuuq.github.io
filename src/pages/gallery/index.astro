---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { bannerPlaceholder, galleryPlaceholder } from "../../lib/placeholders";

const albums = await getCollection("gallery");
---

<BaseLayout title="Gallery" currentPath="/gallery/">
  <PageHero title="Gallery" image={bannerPlaceholder("gallery")} titleClass="hero-gallery" />

  <section class="section">
    <h2 class="section-title">Gallery</h2>
    <div class="gallery-grid">
      {albums.map((album) => (
        <article class="gallery-card">
          <img src={album.data.image ?? galleryPlaceholder(album.data.title)} alt={album.data.imageAlt ?? album.data.title} />
          <h3>{album.data.title}</h3>
          {album.data.date && <div class="inline-meta"><span>{album.data.date}</span></div>}
          <p>{album.body}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
