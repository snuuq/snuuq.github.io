---
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatLongDate } from "../lib/dates";
import { bannerPlaceholder } from "../lib/placeholders";

const allNews = await getCollection("news");
const allGallery = await getCollection("gallery");
const sortByDateDesc = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();
const pinnedNews = allNews.filter((item) => item.data.pinned).sort(sortByDateDesc);
const regularNews = allNews.filter((item) => !item.data.pinned).sort(sortByDateDesc);
const allOrderedNews = [...pinnedNews, ...regularNews];
const news = allOrderedNews.slice(0, 5);
const highlightedGallery = allGallery
  .filter((item) => item.data.highlight && item.data.image)
  .sort(sortByDateDesc);
const heroImages =
  highlightedGallery.length > 0
    ? highlightedGallery.map((item) => ({ src: item.data.image!, alt: item.data.imageAlt ?? item.data.title }))
    : [{ src: bannerPlaceholder("home"), alt: "Home hero" }];
---

<BaseLayout currentPath="/">
  <section class="home-hero">
    <div class={`page-hero is-home`}>
      <div class={`page-hero-media ${heroImages.length > 1 ? "is-slideshow" : ""}`} id="home-hero-slides">
        {heroImages.map((item, index) => (
          <img
            class={`page-hero-image ${index === 0 ? "is-active" : ""}`}
            src={item.src}
            alt={item.alt}
            data-slide
          />
        ))}
      </div>

      <div class="home-hero-copy-wrap">
        <div class="home-hero-copy">
          <p class="home-hero-eyebrow">SNUUQ</p>
          <h1>Uncertainty Quantification Lab</h1>
          <p class="home-hero-summary">
            We develop statistically principled uncertainty quantification methods for scientific models, modern machine
            learning, and reliable decision-making under uncertainty.
          </p>
          <div class="home-hero-actions">
            <a href="/research/" class="home-hero-button is-primary">Research Detail</a>
            <a href="/publications/" class="home-hero-button is-secondary">Publications</a>
            <a href="/seminars/" class="home-hero-button is-secondary">Seminars</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-news">
    <h2 class="section-title">Recent News</h2>
    <ul class="news-list">
      {news.map((item) => (
        <li>
          <strong>{item.data.pinned ? "📌 " : ""}{formatLongDate(item.data.date)}</strong> {item.data.title}
        </li>
      ))}
    </ul>
    {allOrderedNews.length > 5 && (
      <p class="see-more-wrap">
        <a href="/news/" class="see-more-link">See more</a>
      </p>
    )}
  </section>

  {heroImages.length > 1 && (
    <script is:inline>
      const root = document.getElementById("home-hero-slides");
      const slides = root ? Array.from(root.querySelectorAll("[data-slide]")) : [];
      let activeIndex = 0;

      if (slides.length > 1) {
        window.setInterval(() => {
          slides[activeIndex]?.classList.remove("is-active");
          activeIndex = (activeIndex + 1) % slides.length;
          slides[activeIndex]?.classList.add("is-active");
        }, 3800);
      }
    </script>
  )}
</BaseLayout>
