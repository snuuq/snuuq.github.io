---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { bannerPlaceholder } from "../lib/placeholders";

const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout currentPath="/">
  <PageHero
    title="Home"
    image={bannerPlaceholder("home")}
    centered={true}
    overlayText="Welcome to SNUUQ!"
  />

  <section class="home-news">
    <h2 class="section-title">News</h2>
    <ul class="news-list">
      {news.map((item) => (
        <li>
          <strong>{item.data.date.toLocaleDateString("en-CA")}</strong> {item.data.title}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
