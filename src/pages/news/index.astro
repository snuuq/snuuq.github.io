---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { bannerPlaceholder } from "../../lib/placeholders";

const items = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="News" currentPath="/news/">
  <PageHero title="News" image={bannerPlaceholder("news")} titleClass="hero-news" />

  <section class="section">
    <h2 class="section-title">News</h2>
    <ul class="news-page-list">
      {items.map((item) => (
        <li>
          <strong>{item.data.date.toLocaleDateString("en-CA")}</strong> {item.data.title}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
