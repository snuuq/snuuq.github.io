---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatLongDate } from "../../lib/dates";

const allNews = await getCollection("news");
const sortByDateDesc = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();
const pinnedNews = allNews.filter((item) => item.data.pinned).sort(sortByDateDesc);
const regularNews = allNews.filter((item) => !item.data.pinned).sort(sortByDateDesc);
const items = [...pinnedNews, ...regularNews];
---

<BaseLayout title="News" currentPath="/news/">
  <section class="page-title-section">
    <div class="content-narrow">
      <h1 class="page-title">News</h1>
    </div>
  </section>

  <section class="section">
    <ul class="news-page-list">
      {items.map((item) => (
        <li>
          <strong>{item.data.pinned ? "📌 " : ""}{formatLongDate(item.data.date)}</strong> {item.data.title}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
