---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPublications = await getCollection("publications");

const typeOrder = ["Journal", "Submitted", "Book Chapter", "Conference", "Workshop", "Demo", "ArXiv Preprint"] as const;

const typeLabels: Record<(typeof typeOrder)[number], string> = {
  Journal: "Journals",
  "Book Chapter": "Book Chapters",
  Submitted: "Submitted Manuscripts",
  Conference: "Conferences",
  Workshop: "Workshops",
  Demo: "Demos",
  "ArXiv Preprint": "ArXiv Preprints"
};

const groupedPublications = typeOrder
  .map((type) => ({
    type,
    label: typeLabels[type],
    items: allPublications
      .filter((item) => item.data.type === type)
      .sort((a, b) => {
        const aSort = a.data.sortId ?? -1;
        const bSort = b.data.sortId ?? -1;
        if (aSort !== bSort) return bSort - aSort;
        return b.data.year === a.data.year ? a.data.title.localeCompare(b.data.title) : b.data.year - a.data.year;
      })
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout title="Publications" currentPath="/publications/">
  <section class="page-title-section">
    <div class="content-narrow">
      <h1 class="page-title">Publications</h1>
    </div>
  </section>

  {groupedPublications.map((group) => (
    <section class="section">
      <h2 class="section-title">{group.label}</h2>

      <div class="publication-ordered">
        <ol>
          {group.items.map((item) => (
            <li>
              {item.data.authors}. <span class="publication-title-inline">{item.data.title}</span>, <em>{item.data.venue}</em>, {item.data.yearLabel ?? item.data.year}.
              {item.data.links.length > 0 && (
                <span class="publication-links-inline">
                  {item.data.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
</BaseLayout>
