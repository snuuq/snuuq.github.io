---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GiscusComments from "../../../components/GiscusComments.astro";
import { formatLongDate } from "../../../lib/dates";
import { firstSentence } from "../../../lib/text";

export async function getStaticPaths() {
  const sessions = await getCollection("seminarSessions");
  return sessions
    .filter((entry) => entry.data.title.trim().toUpperCase() !== "TBA")
    .map((entry) => ({
    params: {
      series: entry.data.series,
      session: entry.slug
    },
    props: {
      sessionEntry: entry
    }
    }));
}

const { sessionEntry } = Astro.props;
const { Content: SessionContent } = await sessionEntry.render();
const seriesCollection = await getCollection("seminarSeries");
const seriesEntry = seriesCollection.find((item) => item.slug === sessionEntry.data.series);
const sessionDescription = firstSentence(sessionEntry.body);
const materialsLink = sessionEntry.data.materials?.trim();
const hasMaterials = Boolean(materialsLink && materialsLink !== "#");
---

<BaseLayout title={sessionEntry.data.title} description={sessionDescription} currentPath="/seminars/">
  <section class="page-title-section">
    <div class="content-narrow">
      <h1 class="page-title">{sessionEntry.data.title}</h1>
    </div>
  </section>

  <section class="section">
    <div class="seminar-detail">
      <p class="center-note">
        <span class="inline-meta">
          <span>{sessionEntry.data.speaker}</span>
          <span>{formatLongDate(sessionEntry.data.date)}</span>
          <span>{seriesEntry?.data.title ?? sessionEntry.data.series}</span>
          {sessionEntry.data.week && <span>{sessionEntry.data.week}</span>}
        </span>
      </p>
      <h2 class="section-title">Overview</h2>
      <div class="plain-copy markdown-copy">
        <SessionContent />
      </div>
      <div class="button-row seminar-actions">
        {hasMaterials ? (
          <a class="action-button action-button--primary" href={materialsLink}>Presentation Materials</a>
        ) : (
          <span class="action-button action-button--disabled" aria-disabled="true">Presentation Materials TBA</span>
        )}
        {seriesEntry && <a class="action-button" href={`/seminars/${seriesEntry.slug}/`}>Back to Series</a>}
      </div>
    </div>
  </section>
<!--
  <section class="section">
    <div class="seminar-detail">
      <GiscusComments term={sessionEntry.slug} />
    </div>
  </section>
-->
</BaseLayout>
