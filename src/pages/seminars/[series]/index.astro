---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatLongDate } from "../../../lib/dates";

export async function getStaticPaths() {
  const series = await getCollection("seminarSeries");
  return series.map((entry) => ({
    params: { series: entry.slug },
    props: { seriesEntry: entry }
  }));
}

const { seriesEntry } = Astro.props;
const { Content: SeriesContent } = await seriesEntry.render();
const allSessions = await getCollection("seminarSessions");
const seminarSessionModules = import.meta.glob<{ compiledContent: () => Promise<string> }>("../../../content/seminarSessions/*.md");
const voidTags = new Set(["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"]);
const getFirstRenderedBlock = (html: string) => {
  const firstParagraph = html.match(/<p\b[^>]*>[\s\S]*?<\/p>/i);
  if (firstParagraph) return firstParagraph[0];

  const firstBlock = html.match(/<(ul|ol|blockquote|pre|table)\b[^>]*>[\s\S]*?<\/\1>/i);
  return firstBlock ? firstBlock[0] : html;
};
const truncateInlineHtmlToFirstSentence = (html: string) => {
  const tokens = html.match(/<[^>]+>|[^<]+/g) ?? [];
  const openTags: string[] = [];
  let output = "";

  for (const token of tokens) {
    if (token.startsWith("<")) {
      output += token;

      const closingTag = token.match(/^<\/\s*([a-z0-9-]+)/i);
      if (closingTag) {
        const tagName = closingTag[1].toLowerCase();
        const tagIndex = openTags.lastIndexOf(tagName);
        if (tagIndex >= 0) openTags.splice(tagIndex, 1);
        continue;
      }

      const openingTag = token.match(/^<\s*([a-z0-9-]+)/i);
      if (!openingTag || token.endsWith("/>")) continue;

      const tagName = openingTag[1].toLowerCase();
      if (!voidTags.has(tagName) && !token.startsWith("<!") && !token.startsWith("<?")) {
        openTags.push(tagName);
      }
      continue;
    }

    const firstSentence = token.match(/[\s\S]*?[.!?](?=\s|$)/);
    if (!firstSentence) {
      output += token;
      continue;
    }

    output += firstSentence[0];
    return `${output}${openTags.slice().reverse().map((tagName) => `</${tagName}>`).join("")}`;
  }

  return html;
};
const truncateRenderedBlockToFirstSentence = (html: string) => {
  const trimmed = html.trim();
  const paragraphMatch = trimmed.match(/^<p\b([^>]*)>([\s\S]*?)<\/p>$/i);
  if (!paragraphMatch) return trimmed;

  const attributes = paragraphMatch[1];
  const innerHtml = paragraphMatch[2];
  return `<p${attributes}>${truncateInlineHtmlToFirstSentence(innerHtml)}</p>`;
};
const renderedSessions = await Promise.all(
  allSessions
    .filter((item) => item.data.series === seriesEntry.slug)
    .map(async (item) => {
      const modulePath = Object.keys(seminarSessionModules).find((path) => path.endsWith(`/${item.slug}.md`));
      const module = modulePath ? await seminarSessionModules[modulePath]() : null;
      const previewHtml = module ? truncateRenderedBlockToFirstSentence(getFirstRenderedBlock(await module.compiledContent())) : "";
      return { ...item, previewHtml };
    })
);
const sessions = renderedSessions.sort((a, b) => {
    if (seriesEntry.data.sortOrder === "desc") {
      return b.data.date.valueOf() - a.data.date.valueOf();
    }
    if (a.data.week && b.data.week) {
      return Number(a.data.week.replace(/\D+/g, "")) - Number(b.data.week.replace(/\D+/g, ""));
    }
    return a.data.date.valueOf() - b.data.date.valueOf();
  });
const isJournalClub = seriesEntry.slug === "journal-club";
---

{seriesEntry.data.externalLink && (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0;url=${seriesEntry.data.externalLink}`} />
      <link rel="canonical" href={seriesEntry.data.externalLink} />
    </head>
    <body>
      <p>
        Redirecting to <a href={seriesEntry.data.externalLink}>{seriesEntry.data.externalLink}</a>...
      </p>
    </body>
  </html>
)}

{!seriesEntry.data.externalLink && (
  <BaseLayout title={seriesEntry.data.title} currentPath="/seminars/">
    <section class="page-title-section">
      <div class="content-narrow">
        <h1 class="page-title">{seriesEntry.data.title}</h1>
      </div>
    </section>

    <section class="section">
      <div class="content-narrow center-note markdown-copy">
        <SeriesContent />
      </div>
      <div class="sessions-ordered">
        <ol class={isJournalClub ? "is-unstyled" : undefined}>
          {sessions.map((session) => (
            <li class="session-entry">
              <h3>{!isJournalClub && session.data.week ? `${session.data.week} : ${session.data.title}` : session.data.title}</h3>
              <p class="inline-meta">
                <span>{session.data.speaker}</span>
                <span>{formatLongDate(session.data.date)}</span>
              </p>
              {session.previewHtml && (
                <div class="session-preview markdown-copy compact-markdown" set:html={session.previewHtml} />
              )}
              {session.data.title.trim().toUpperCase() !== "TBA" && (
                <a class="text-button" href={`/seminars/${seriesEntry.slug}/${session.slug}/`}>Open Session</a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  </BaseLayout>
)}
