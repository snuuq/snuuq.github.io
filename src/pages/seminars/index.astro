---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatLongDate } from "../../lib/dates";
import { firstSentence } from "../../lib/text";

const series = await getCollection("seminarSeries");
const pages = await getCollection("pages");
const seminarsPage = pages.find((item) => item.slug === "seminars");
const seminarsPageRender = seminarsPage ? await seminarsPage.render() : null;
const SeminarsPageContent = seminarsPageRender?.Content;
const renderedSeries = await Promise.all(
  series.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
const journalClub = renderedSeries.find((item) => item.slug === "journal-club");
const seasonal = renderedSeries
  .filter((item) => item.slug !== "journal-club")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const getSeriesHref = (item) => item.data.externalLink ?? `/seminars/${item.slug}/`;
const getSeriesPreview = (item) => firstSentence(item.body);
---

<BaseLayout title="Seminars" currentPath="/seminars/">
  <section class="page-title-section">
    <div class="content-narrow">
      <h1 class="page-title">Seminars</h1>
    </div>
  </section>

  <section class="section">
    <div class="content-narrow center-note markdown-copy">
      {SeminarsPageContent ? <SeminarsPageContent /> : (
        <>
          <p>During semesters we run a cumulative Journal Club.</p>
          <p>During breaks we organize focused seasonal seminars such as book seminars and topical reading seminars.</p>
        </>
      )}
    </div>

    {journalClub && (
      <>
        <div class="seminar-series-list">
          <article class="seminar-series-card">
            <h3>{journalClub.data.title}</h3>
            <p>{getSeriesPreview(journalClub)}</p>
            <a
              class="text-button"
              href={getSeriesHref(journalClub)}
              target={journalClub.data.externalLink ? "_blank" : undefined}
              rel={journalClub.data.externalLink ? "noreferrer" : undefined}
            >
              Open Journal Club
            </a>
          </article>
        </div>
      </>
    )}
  </section>

  <section class="section">
    <h2 class="section-title">Seasonal Seminars</h2>
    <div class="seminar-series-list">
      {seasonal.map((item) => (
        <article class="seminar-series-card">
          <h3>{item.data.title}</h3>
          <p>{getSeriesPreview(item)}</p>
          <a
            class="text-button"
            href={getSeriesHref(item)}
            target={item.data.externalLink ? "_blank" : undefined}
            rel={item.data.externalLink ? "noreferrer" : undefined}
          >
            View Series
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
